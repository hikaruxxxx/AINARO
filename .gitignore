# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# crawled data
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/
.vercel/

# python
__pycache__/
*.pyc
*.pyo

# claude code runtime
.claude/scheduled_tasks.lock
.claude/worktrees/

# 漫画素材（大型バイナリ・ローカル参照のみ）
/data/manga/raw/kindle-references/
/data/manga/raw/manual/
/data/manga/_archive/
# 漫画パイプライン v2 生成物 (PNG/PDF は git に乗せない、JSON は乗せる)
/data/manga/style-plates/*.png
/data/manga/works/*/bible/refs/characters/
/data/manga/works/*/bible/refs/locations/
/data/manga/works/*/bible/refs/props/
/data/manga/works/*/episodes/*/renders/
/data/manga/works/*/episodes/*/bubbles/
/data/manga/works/*/episodes/*/_incremental_refs/
/data/manga/works/*/volumes/*/kdp/*.pdf
/data/manga/works/*/volumes/*/kdp/_colophon.png
